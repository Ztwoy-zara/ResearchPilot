# ResearchPilot environment template
# Copy this file to .env and fill in your own keys.
# Never place real API keys in this example file.

# Required: DeepSeek model
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Required: web search
TAVILY_API_KEY=

# Optional: LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ResearchPilot